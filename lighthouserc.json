{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Servindo",
      "url": [
        "http://127.0.0.1:4173/SITEIPHONE/",
        "http://127.0.0.1:4173/SITEIPHONE/pages/modelos.html",
        "http://127.0.0.1:4173/SITEIPHONE/pages/fotos.html",
        "http://127.0.0.1:4173/SITEIPHONE/pages/videos.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/relatorios"
    }
  }
}
